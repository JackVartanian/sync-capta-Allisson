# ============================================================
# Modelo de configuracao - copie para .env e preencha os valores
#   cp .env.example .env
# ============================================================

# SQL Server do ERP Capta (rede interna / VPN)
CAPTA_DB_SERVER=
CAPTA_DB_PORT=1433
CAPTA_DB_DATABASE=
CAPTA_DB_USERNAME=
CAPTA_DB_PASSWORD=

# PostgreSQL (EasyPanel)
POSTGRES_URL=

# FTP de publicacao dos datasets (wp-content/uploads/datasets)
FTP_HOST=
FTP_USERNAME=
FTP_PASSWORD=
